# Keepalive server secrets. Never commit the real file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs, free tier is enough. Voice id is resolved from the account when blank,
# because accounts created after March 2026 do not carry the documented default voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# Solana devnet signer, base64 of the 64 byte secret key. Devnet only, no real value.
SOLANA_SECRET_KEY=
SOLANA_RPC=https://api.devnet.solana.com

# Snowflake, key pair JWT. The SQL REST API has never accepted a password.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=KEEPALIVE
SNOWFLAKE_SCHEMA=PUBLIC
